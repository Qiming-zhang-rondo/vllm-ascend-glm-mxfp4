// Compile/link only. This library is never loaded or run on the device.
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/device_functions.h"

__simt_vf__ __aicore__ LAUNCH_BOUND(32) inline void QsfaProbeVf(__gm__ float* p)
{
    p[threadIdx.x] = float(threadIdx.x);
}

__global__ __aicore__ __vector__ void QsfaProbeVector(GM_ADDR p)
{
    AscendC::Simt::VF_CALL<QsfaProbeVf>(AscendC::Simt::Dim3(32), (__gm__ float*)p);
}

__global__ __aicore__ __cube__ void QsfaProbeCube() {}

extern "C" void qsfa_toolchain_probe(aclrtStream stream, void* p)
{
    QsfaProbeVector<<<1, nullptr, stream>>>((GM_ADDR)p);
    QsfaProbeCube<<<1, nullptr, stream>>>();
}
