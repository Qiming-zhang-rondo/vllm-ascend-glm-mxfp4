// Three-stage experiment, NOT a fully fused FlashAttention implementation.
// Source witnesses at cann/ops-transformer@55498d916342:
// examples/attention/flash_attn/L0_minimal/.../fa_kernel_interface.h: raw mixed launch
// attention/common/op_kernel/attn_buffer.h: mode-4 flags, AIV1 offset16
// attention/kv_quant_sparse_flash_attention/op_kernel/arch35/*service_*:
//   UB->L1 NZ producer and FP32 Fixpipe dual-destination UB consumer
// attention/quant_lightning_indexer_v2/op_kernel/arch35/*service_cube*:
//   paired E8M0 DN2NZ and MX LoadData
// No full expanded K or BF16 V is allocated in GM. Full scores and P still are.
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/common_functions.h"
#include "simt_api/device_functions.h"
#include "simt_api/device_warp_functions.h"
#include "simt_api/math_functions.h"
#include "launch.h"
#define QSFA_INLINE __simt_callee__ inline __attribute__((always_inline))
#define QSFA_LAYOUT_INLINE QSFA_INLINE
#include "codec.h"
#include "tiled_layout.h"
#include "tiled_gather.h"

namespace {
using namespace AscendC;
using namespace qsfa_tiled;
using namespace qsfa_codec;
constexpr uint32_t READY = 0;
constexpr uint32_t RELEASE = 1;
constexpr uint32_t OUT_READY = 2;
constexpr uint32_t OUT_FREE = 3;
constexpr uint32_t AIV_OFFSET = 16;
constexpr FixpipeConfig ROW_MAJOR_GM_CFG = {CO2Layout::ROW_MAJOR, false};
constexpr FixpipeConfig ROW_MAJOR_UB_CFG = {CO2Layout::ROW_MAJOR, true};

template <typename T>
__aicore__ inline LocalTensor<T> L1(uint32_t bytes, uint32_t count)
{
    return LocalTensor<T>(TPosition::A1, bytes, count);
}
template <typename T>
__aicore__ inline LocalTensor<T> Ub(uint32_t bytes, uint32_t count)
{
    // This layout uses physical UB offsets from zero on AIC and both AIVs.
    // Do not mix in statically allocated __ubuf__ arrays: they would shift the
    // dynamic region and require relocating the Fixpipe destination as well.
    return LocalTensor<T>(TPosition::VECIN, bytes, count);
}
template <HardEvent event>
__aicore__ inline void Fence()
{
    SetFlag<event>(EVENT_ID0);
    WaitFlag<event>(EVENT_ID0);
}
__aicore__ inline void WaitInput()
{
    CrossCoreWaitFlag<4, PIPE_MTE1>(READY);
    CrossCoreWaitFlag<4, PIPE_MTE1>(READY + AIV_OFFSET);
}
__aicore__ inline void ReleaseInput()
{
    // Only after all LoadData reads have completed on MTE1.
    CrossCoreSetFlag<4, PIPE_MTE1>(RELEASE);
    CrossCoreSetFlag<4, PIPE_MTE1>(RELEASE + AIV_OFFSET);
}
__aicore__ inline LoadData2DParamsV2 NtLoad(uint32_t rows, uint32_t k, uint32_t c0)
{
    LoadData2DParamsV2 p{};
    p.mStep = rows / M;
    p.kStep = k / c0;
    p.srcStride = rows / M;
    p.dstStride = rows / M;
    p.ifTranspose = false;
    return p;
}
__aicore__ inline LoadData2DMxParams MxLoad(uint32_t rows)
{
    LoadData2DMxParams p{};
    p.xStep = rows / M;
    p.yStep = K / 32 / 2;
    p.srcStride = p.yStep;
    p.dstStride = p.yStep;
    return p;
}

class Cube {
public:
    template <typename T>
    __aicore__ inline void Multiply(const LocalTensor<T>& a, const LocalTensor<T>& b,
                                    uint32_t k, bool initialize)
    {
        Fence<HardEvent::MTE1_M>();
        MmadParams p{};
        p.m = M;
        p.n = N;
        p.k = k;
        p.cmatrixInitVal = initialize;
        p.cmatrixSource = false;
        Mmad(C(), a, b, p);
        PipeBarrier<PIPE_M>();
        Fence<HardEvent::M_MTE1>();
    }
    __aicore__ inline void Mx(uint32_t chunk)
    {
        auto a = LocalTensor<mx_fp8_e4m3_t>(TPosition::A2, 0, M * K);
        auto b = LocalTensor<mx_fp8_e4m3_t>(TPosition::B2, 0, N * K);
        LoadData(a, L1<fp8_e4m3fn_t>(Q_DATA + chunk * M * K, M * K),
                 L1<fp8_e8m0_t>(Q_SCALE + chunk * M * 4, M * 4), NtLoad(M, K, 32), MxLoad(M));
        LoadData(b, L1<fp8_e4m3fn_t>(K_DATA + chunk * N * K, N * K),
                 L1<fp8_e8m0_t>(K_SCALE + chunk * N * 4, N * 4), NtLoad(N, K, 32), MxLoad(N));
        Multiply(a, b, K, chunk == 0);
    }
    __aicore__ inline void Bf16(uint32_t aOffset, uint32_t bOffset, uint32_t k, bool initialize)
    {
        auto a = LocalTensor<bfloat16_t>(TPosition::A2, 0, M * K);
        auto b = LocalTensor<bfloat16_t>(TPosition::B2, 0, N * K);
        LoadData(a, L1<bfloat16_t>(aOffset, M * k), NtLoad(M, k, 16));
        LoadData(b, L1<bfloat16_t>(bOffset, N * k), NtLoad(N, k, 16));
        Multiply(a, b, k, initialize);
    }
    __aicore__ inline void Store(const GlobalTensor<float>& out, uint32_t stride)
    {
        Fence<HardEvent::M_FIX>();
        FixpipeParamsC310<CO2Layout::ROW_MAJOR> p{};
        p.mSize = M;
        p.nSize = N;
        p.srcStride = M;
        p.dstStride = stride;
        p.params.ndNum = 1;
        Fixpipe<float, float, ROW_MAJOR_GM_CFG>(out, C(), p);
        Fence<HardEvent::FIX_M>();
    }
    __aicore__ inline void OutputUb()
    {
        Fence<HardEvent::M_FIX>();
        CrossCoreWaitFlag<4, PIPE_FIX>(OUT_FREE);
        CrossCoreWaitFlag<4, PIPE_FIX>(OUT_FREE + AIV_OFFSET);
        FixpipeParamsC310<CO2Layout::ROW_MAJOR> p{};
        p.mSize = M;
        p.nSize = N;
        p.srcStride = M;
        p.dstStride = N;
        p.dualDstCtl = 1; // Rows0:8 -> AIV0, rows8:16 -> AIV1, local UB offset identical.
        p.params.ndNum = 1;
        Fixpipe<float, float, ROW_MAJOR_UB_CFG>(Ub<float>(PV_OUT_UB, (M / 2) * N), C(), p);
        CrossCoreSetFlag<4, PIPE_FIX>(OUT_READY);
        CrossCoreSetFlag<4, PIPE_FIX>(OUT_READY + AIV_OFFSET);
        Fence<HardEvent::FIX_M>();
    }
private:
    __aicore__ inline LocalTensor<float> C() { return LocalTensor<float>(TPosition::CO1, 0, M * N); }
};

__aicore__ inline void CopyQkToL1(uint32_t sub)
{
    Fence<HardEvent::V_MTE3>();
    for (uint32_t chunk = 0; chunk < 4; ++chunk) {
        DataCopyParams cp{};
        cp.blockCount = K / 32;
        cp.blockLen = HALF_N;
        cp.dstGap = HALF_N;
        DataCopy(L1<uint8_t>(K_DATA + chunk * N * K + sub * HALF_N * 32, N * K - sub * HALF_N * 32),
                 Ub<uint8_t>(UK + chunk * HALF_N * K, HALF_N * K), cp);
        DataCopy(L1<uint8_t>(K_SCALE + chunk * N * 4 + sub * HALF_N * 4, HALF_N * 4),
                 Ub<uint8_t>(UKS + chunk * HALF_N * 4, HALF_N * 4), HALF_N * 4);
    }
    DataCopyParams ropeCopy{};
    ropeCopy.blockCount = 64 / 16;
    ropeCopy.blockLen = HALF_N;
    ropeCopy.dstGap = HALF_N;
    DataCopy(L1<bfloat16_t>(K_ROPE + sub * HALF_N * 16 * 2, N * 64 - sub * HALF_N * 16),
             Ub<bfloat16_t>(UKR, HALF_N * 64), ropeCopy);
    if (sub == 0) {
        DataCopy(L1<uint8_t>(Q_DATA, M * 512), Ub<uint8_t>(UQ, M * 512), M * 512);
        DataCopy(L1<uint8_t>(Q_SCALE, M * 16), Ub<uint8_t>(UQS, M * 16), M * 16);
        DataCopy(L1<bfloat16_t>(Q_ROPE, M * 64), Ub<bfloat16_t>(UQR, M * 64), M * 64);
    }
    CrossCoreSetFlag<4, PIPE_MTE3>(READY);
    Fence<HardEvent::MTE3_V>(); // Staging UB must not be overwritten while MTE3 reads it.
}

__global__ __aicore__ void QkTiledKernel(
    GM_ADDR q, GM_ADDR qs, GM_ADDR kv, GM_ADDR ks, GM_ADDR rope, GM_ADDR idx,
    GM_ADDR scores, GM_ADDR status, uint32_t h, uint32_t m, uint32_t cacheRows,
    uint32_t selected, uint32_t blocks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    InitSocState();
    const uint32_t nTiles = selected / N, tiles = (m / M) * nTiles;
    if ASCEND_IS_AIC {
        GlobalTensor<float> scoreGm;
        scoreGm.SetGlobalBuffer((__gm__ float*)scores);
        Cube cube;
        for (uint32_t tile = GetBlockIdx(); tile < tiles; tile += blocks) {
            WaitInput();
            for (uint32_t chunk = 0; chunk < 4; ++chunk) cube.Mx(chunk);
            cube.Bf16(Q_ROPE, K_ROPE, 64, false);
            ReleaseInput();
            cube.Store(scoreGm[(tile / nTiles) * M * selected + (tile % nTiles) * N], selected);
        }
    } else {
        const uint32_t block = GetBlockIdx() / 2, sub = GetSubBlockIdx();
        bool first = true;
        for (uint32_t tile = block; tile < tiles; tile += blocks) {
            if (!first) CrossCoreWaitFlag<4, PIPE_MTE3>(RELEASE);
            Simt::VF_CALL<qsfa_tiled_gather::PrepareQk>(Simt::Dim3(THREADS),
                (__gm__ uint8_t*)q, (__gm__ uint8_t*)qs, (__gm__ uint8_t*)kv,
                (__gm__ uint8_t*)ks, (__gm__ uint16_t*)rope, (__gm__ int32_t*)idx,
                (__gm__ int32_t*)status, (__ubuf__ uint8_t*)Ub<uint8_t>(0, QK_UB_BYTES).GetPhyAddr(),
                h, cacheRows, selected, (tile / nTiles) * M, (tile % nTiles) * N,
                sub, first && block == 0 && sub == 0);
            CopyQkToL1(sub);
            first = false;
        }
        if (!first) CrossCoreWaitFlag<4, PIPE_MTE3>(RELEASE); // Drain final release, no live flags.
    }
    PipeBarrier<PIPE_ALL>();
}

__simt_vf__ __aicore__ LAUNCH_BOUND(THREADS) inline void EncodeOutput(
    __ubuf__ float* acc, __gm__ uint8_t* out, __gm__ uint8_t* scales,
    uint32_t h, uint32_t mOffset, uint32_t dOffset)
{
    const uint32_t lane = threadIdx.x & 31;
    for (uint32_t group = threadIdx.x / 32; group < (M / 2) * (N / 32); group += THREADS / 32) {
        const uint32_t row = group / (N / 32), dg = group % (N / 32);
        if (mOffset + row >= h) continue;
        const float x = acc[row * N + dg * 32 + lane];
        float maximum = Finite(x) ? Abs(x) : Float(0x7f800000U);
        for (uint32_t delta = 16; delta > 0; delta /= 2)
            maximum = fmaxf(maximum, asc_shfl_xor(maximum, delta, 32));
        const uint8_t exponent = SharedExponent(maximum);
        if (lane == 0) scales[(mOffset + row) * 16 + dOffset / 32 + dg] = exponent;
        const float normalized = x == 0.0f ? x :
            (exponent == 0 ? x * Float(0x7f000000U) : x / Scale(exponent));
        out[(mOffset + row) * 512 + dOffset + dg * 32 + lane] =
            exponent == 255 ? 0x7fU : EncodeFp8(normalized);
    }
}

__global__ __aicore__ void PvTiledKernel(
    GM_ADDR p, GM_ADDR kv, GM_ADDR ks, GM_ADDR idx, GM_ADDR out, GM_ADDR outScale,
    uint32_t h, uint32_t m, uint32_t cacheRows, uint32_t selected, uint32_t blocks)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    InitSocState();
    constexpr uint32_t nTiles = 512 / N;
    const uint32_t tiles = (m / M) * nTiles;
    if ASCEND_IS_AIC {
        GlobalTensor<bfloat16_t> pGm;
        pGm.SetGlobalBuffer((__gm__ bfloat16_t*)p);
        Cube cube;
        for (uint32_t tile = GetBlockIdx(); tile < tiles; tile += blocks) {
            for (uint32_t token = 0; token < selected; token += K) {
                Nd2NzParams cp{};
                cp.ndNum = 1;
                cp.nValue = M;
                cp.dValue = K;
                cp.srcDValue = selected;
                cp.dstNzC0Stride = M;
                cp.dstNzNStride = 1;
                DataCopy(L1<bfloat16_t>(PV_P, M * K), pGm[(tile / nTiles) * M * selected + token], cp);
                Fence<HardEvent::MTE2_MTE1>();
                WaitInput();
                cube.Bf16(PV_P, PV_V, K, token == 0);
                Fence<HardEvent::MTE1_MTE2>(); // P L1 can be overwritten only after its LoadData.
                ReleaseInput();
            }
            cube.OutputUb();
        }
        CrossCoreWaitFlag<4, PIPE_FIX>(OUT_FREE);
        CrossCoreWaitFlag<4, PIPE_FIX>(OUT_FREE + AIV_OFFSET);
    } else {
        const uint32_t block = GetBlockIdx() / 2, sub = GetSubBlockIdx();
        CrossCoreSetFlag<4, PIPE_V>(OUT_FREE);
        bool first = true;
        for (uint32_t tile = block; tile < tiles; tile += blocks) {
            for (uint32_t token = 0; token < selected; token += K) {
                if (!first) CrossCoreWaitFlag<4, PIPE_MTE3>(RELEASE);
                Simt::VF_CALL<qsfa_tiled_gather::PreparePv>(Simt::Dim3(THREADS),
                    (__gm__ uint8_t*)kv, (__gm__ uint8_t*)ks, (__gm__ int32_t*)idx,
                    (__ubuf__ uint16_t*)Ub<uint16_t>(0, N * HALF_K).GetPhyAddr(),
                    cacheRows, token + sub * HALF_K, (tile % nTiles) * N);
                Fence<HardEvent::V_MTE3>();
                DataCopy(L1<bfloat16_t>(PV_V + sub * N * HALF_K * 2, N * HALF_K),
                         Ub<bfloat16_t>(0, N * HALF_K), N * HALF_K);
                CrossCoreSetFlag<4, PIPE_MTE3>(READY);
                Fence<HardEvent::MTE3_V>();
                first = false;
            }
            CrossCoreWaitFlag<4, PIPE_V>(OUT_READY);
            Simt::VF_CALL<EncodeOutput>(Simt::Dim3(THREADS),
                (__ubuf__ float*)Ub<float>(PV_OUT_UB, (M / 2) * N).GetPhyAddr(),
                (__gm__ uint8_t*)out, (__gm__ uint8_t*)outScale,
                h, (tile / nTiles) * M + sub * (M / 2), (tile % nTiles) * N);
            CrossCoreSetFlag<4, PIPE_V>(OUT_FREE);
        }
        if (!first) CrossCoreWaitFlag<4, PIPE_MTE3>(RELEASE);
    }
    PipeBarrier<PIPE_ALL>();
}
}  // namespace

extern "C" void qsfa_qk_tiled_launch(aclrtStream stream, void* q, void* qs, void* kv, void* ks,
    void* rope, void* indices, void* scores, void* status,
    uint32_t h, uint32_t m, uint32_t k, uint32_t s)
{
    const uint32_t tiles = (m / qsfa_tiled::M) * (s / qsfa_tiled::N);
    const uint32_t blocks = tiles < qsfa_tiled::MAX_BLOCKS ? tiles : qsfa_tiled::MAX_BLOCKS;
    // The second argument is dynamic UB bytes, not an unused L2-control pointer.
    // Zero leaves the fixed LocalTensor addresses outside the SIMT UB region.
    QkTiledKernel<<<blocks, qsfa_tiled::DYNAMIC_UB_BYTES, stream>>>((GM_ADDR)q, (GM_ADDR)qs, (GM_ADDR)kv,
        (GM_ADDR)ks, (GM_ADDR)rope, (GM_ADDR)indices, (GM_ADDR)scores, (GM_ADDR)status, h, m, k, s, blocks);
}
extern "C" void qsfa_pv_tiled_launch(aclrtStream stream, void* p, void* kv, void* ks,
    void* indices, void* out, void* oscale, uint32_t h, uint32_t m, uint32_t k, uint32_t s)
{
    const uint32_t tiles = (m / qsfa_tiled::M) * (512 / qsfa_tiled::N);
    const uint32_t blocks = tiles < qsfa_tiled::MAX_BLOCKS ? tiles : qsfa_tiled::MAX_BLOCKS;
    PvTiledKernel<<<blocks, qsfa_tiled::DYNAMIC_UB_BYTES, stream>>>((GM_ADDR)p, (GM_ADDR)kv, (GM_ADDR)ks,
        (GM_ADDR)indices, (GM_ADDR)out, (GM_ADDR)oscale, h, m, k, s, blocks);
}
