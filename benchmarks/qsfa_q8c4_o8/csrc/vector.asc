// SPDX-License-Identifier: Apache-2.0
// A5 direct-launch research prototype. SIMT API usage follows CANN
// ops-transformer@55498d916342 attention/scatter_pa_kv_cache_with_k_scale
// and mhc/mhc_pre_sinkhorn_backward/op_kernel/arch35/*simt_vf.h.
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "simt_api/common_functions.h"
#include "simt_api/device_functions.h"
#include "simt_api/device_sync_functions.h"
#include "simt_api/device_warp_functions.h"
#include "simt_api/math_functions.h"
#include "launch.h"

// SIMT VFs may call __simt_callee__ functions, not scalar __aicore__ helpers.
#define QSFA_INLINE __simt_callee__ inline __attribute__((always_inline))
#include "codec.h"

using namespace AscendC;
using namespace qsfa_codec;
namespace {
constexpr uint32_t THREADS = 256;
constexpr uint32_t VECTOR_BLOCKS = 32;

__simt_vf__ __aicore__ LAUNCH_BOUND(THREADS) inline void GatherVf(
    __gm__ uint8_t* q, __gm__ uint8_t* qs, __gm__ uint8_t* kv,
    __gm__ uint8_t* ks, __gm__ uint16_t* rope, __gm__ int32_t* indices,
    __gm__ uint8_t* qn, __gm__ uint8_t* qns, __gm__ uint16_t* qr,
    __gm__ uint8_t* kn, __gm__ uint8_t* kns, __gm__ uint16_t* kr,
    __gm__ uint16_t* vt, __gm__ int32_t* status,
    uint32_t h, uint32_t m, uint32_t k, uint32_t s)
{
    const uint32_t tid = blockIdx.x * THREADS + threadIdx.x;
    const uint32_t stride = gridDim.x * THREADS;
    // Exactly one status writer: no initialization-vs-atomic race. Every gather
    // below independently bounds-checks its index before reading cache memory.
    if (tid == 0) {
        int32_t invalid = 0;
        for (uint32_t row = 0; row < s; ++row) {
            const int32_t slot = indices[row];
            if (slot < 0 || uint32_t(slot) >= k) invalid = 1;
        }
        status[0] = invalid;
    }
    for (uint32_t i = tid; i < m * 512U; i += stride) {
        const uint32_t row = i / 512U, d = i % 512U;
        qn[i] = row < h ? q[row * 576U + d] : 0;
    }
    for (uint32_t i = tid; i < m * 16U; i += stride) {
        const uint32_t row = i / 16U, group = i % 16U;
        qns[i] = row < h ? qs[row * 18U + group] : 127;
    }
    for (uint32_t i = tid; i < m * 64U; i += stride) {
        const uint32_t row = i / 64U, d = i % 64U;
        qr[i] = row < h ? Bf16(DecodeFp8(q[row * 576U + 512U + d]) *
                              Scale(qs[row * 18U + 16U + d / 32U])) : 0;
    }
    for (uint32_t i = tid; i < s * 512U; i += stride) {
        const uint32_t row = i / 512U, d = i % 512U;
        const int32_t slot = indices[row];
        const bool valid = slot >= 0 && uint32_t(slot) < k;
        uint8_t fp8 = 0;
        uint8_t scale = 127;
        if (valid) {
            const uint8_t byte = kv[uint64_t(slot) * 256U + d / 2U];
            const uint8_t nibble = (byte >> ((d & 1U) * 4U)) & 15U;
            fp8 = ExpandFp4(nibble); // Exact E2M1 -> E4M3; no /64 trick.
            scale = ks[uint64_t(slot) * 16U + d / 32U];
        }
        kn[i] = fp8;
        // PV reduction is over selected tokens, NOT D32. Decode to BF16,
        // materializing transposed V for the separate BF16 Cube kernel.
        vt[uint64_t(d) * s + row] = Bf16(DecodeFp8(fp8) * Scale(scale));
    }
    for (uint32_t i = tid; i < s * 16U; i += stride) {
        const uint32_t row = i / 16U, group = i % 16U;
        const int32_t slot = indices[row];
        kns[i] = slot >= 0 && uint32_t(slot) < k ? ks[uint64_t(slot) * 16U + group] : 127;
    }
    for (uint32_t i = tid; i < s * 64U; i += stride) {
        const uint32_t row = i / 64U, d = i % 64U;
        const int32_t slot = indices[row];
        kr[i] = slot >= 0 && uint32_t(slot) < k ? rope[uint64_t(slot) * 64U + d] : 0;
    }
}

__global__ __aicore__ __vector__ void GatherKernel(
    GM_ADDR q, GM_ADDR qs, GM_ADDR kv, GM_ADDR ks, GM_ADDR rope, GM_ADDR indices,
    GM_ADDR qn, GM_ADDR qns, GM_ADDR qr, GM_ADDR kn, GM_ADDR kns,
    GM_ADDR kr, GM_ADDR vt, GM_ADDR status, uint32_t h, uint32_t m, uint32_t k, uint32_t s)
{
    Simt::VF_CALL<GatherVf>(Simt::Dim3(THREADS),
        (__gm__ uint8_t*)q, (__gm__ uint8_t*)qs, (__gm__ uint8_t*)kv,
        (__gm__ uint8_t*)ks, (__gm__ uint16_t*)rope, (__gm__ int32_t*)indices,
        (__gm__ uint8_t*)qn, (__gm__ uint8_t*)qns, (__gm__ uint16_t*)qr,
        (__gm__ uint8_t*)kn, (__gm__ uint8_t*)kns, (__gm__ uint16_t*)kr,
        (__gm__ uint16_t*)vt, (__gm__ int32_t*)status, h, m, k, s);
}

__simt_vf__ __aicore__ LAUNCH_BOUND(THREADS) inline void SoftmaxVf(
    __gm__ float* scores, __gm__ uint16_t* p, uint32_t m, uint32_t s, float scale)
{
    // One warp owns a complete row: no shared UB, cross-warp barrier or global
    // reduction workspace. This intentionally conservative prototype trades
    // peak occupancy for an auditable synchronization contract.
    const uint32_t globalThread = blockIdx.x * THREADS + threadIdx.x;
    const uint32_t lane = threadIdx.x & 31U;
    for (uint32_t row = globalThread / 32U; row < m; row += gridDim.x * THREADS / 32U) {
        float maximum = -3.402823466e38f;
        for (uint32_t col = lane; col < s; col += 32U)
            maximum = fmaxf(maximum, scores[row * s + col] * scale);
        for (uint32_t delta = 16; delta > 0; delta /= 2)
            maximum = fmaxf(maximum, asc_shfl_xor(maximum, delta, 32));
        float denominator = 0;
        for (uint32_t col = lane; col < s; col += 32U) {
            const uint32_t i = row * s + col;
            const float value = expf(scores[i] * scale - maximum);
            scores[i] = value;
            denominator += value;
        }
        for (uint32_t delta = 16; delta > 0; delta /= 2)
            denominator += asc_shfl_xor(denominator, delta, 32);
        // Every lane reads only the exponential values it wrote above.
        for (uint32_t col = lane; col < s; col += 32U) {
            const uint32_t i = row * s + col;
            p[i] = Bf16(scores[i] / denominator); // Official BF16 P boundary.
        }
    }
}

__global__ __aicore__ __vector__ void SoftmaxKernel(
    GM_ADDR scores, GM_ADDR p, uint32_t m, uint32_t s, float scale)
{
    Simt::VF_CALL<SoftmaxVf>(Simt::Dim3(THREADS), (__gm__ float*)scores,
        (__gm__ uint16_t*)p, m, s, scale);
}

__simt_vf__ __aicore__ LAUNCH_BOUND(THREADS) inline void OutputVf(
    __gm__ float* acc, __gm__ uint8_t* out, __gm__ uint8_t* scales, uint32_t h)
{
    const uint32_t globalThread = blockIdx.x * THREADS + threadIdx.x;
    const uint32_t lane = threadIdx.x & 31U;
    for (uint32_t group = globalThread / 32U; group < h * 16U;
         group += gridDim.x * THREADS / 32U) {
        const float x = acc[group * 32U + lane];
        float maximum = Finite(x) ? Abs(x) : Float(0x7f800000U);
        for (uint32_t delta = 16; delta > 0; delta /= 2)
            maximum = fmaxf(maximum, asc_shfl_xor(maximum, delta, 32));
        const uint8_t exponent = SharedExponent(maximum);
        if (lane == 0) scales[group] = exponent;
        // All-zero groups have E8M0=0. Avoid dividing zero by a subnormal
        // scale on a device configured to flush subnormal arithmetic.
        const float normalized = x == 0.0f ? x :
            (exponent == 0 ? x * Float(0x7f000000U) : x / Scale(exponent));
        out[group * 32U + lane] = exponent == 255 ? 0x7fU : EncodeFp8(normalized);
    }
}

__global__ __aicore__ __vector__ void OutputKernel(GM_ADDR acc, GM_ADDR out, GM_ADDR scales, uint32_t h)
{
    Simt::VF_CALL<OutputVf>(Simt::Dim3(THREADS), (__gm__ float*)acc,
        (__gm__ uint8_t*)out, (__gm__ uint8_t*)scales, h);
}
} // namespace

extern "C" void qsfa_gather_launch(aclrtStream stream, void* q, void* qs, void* kv, void* ks,
    void* rope, void* indices, void* qn, void* qns, void* qr, void* kn, void* kns,
    void* kr, void* vt, void* status, uint32_t h, uint32_t m, uint32_t k, uint32_t s)
{
    GatherKernel<<<VECTOR_BLOCKS, nullptr, stream>>>((GM_ADDR)q, (GM_ADDR)qs, (GM_ADDR)kv,
        (GM_ADDR)ks, (GM_ADDR)rope, (GM_ADDR)indices, (GM_ADDR)qn, (GM_ADDR)qns, (GM_ADDR)qr,
        (GM_ADDR)kn, (GM_ADDR)kns, (GM_ADDR)kr, (GM_ADDR)vt, (GM_ADDR)status, h, m, k, s);
}
extern "C" void qsfa_softmax_launch(aclrtStream stream, void* scores, void* p,
    uint32_t m, uint32_t s, float scale)
{
    const uint32_t blocks = (m + 7U) / 8U;
    SoftmaxKernel<<<blocks, nullptr, stream>>>((GM_ADDR)scores, (GM_ADDR)p, m, s, scale);
}
extern "C" void qsfa_output_launch(aclrtStream stream, void* acc, void* out, void* scales, uint32_t h)
{
    const uint32_t blocks = h * 2U < VECTOR_BLOCKS ? h * 2U : VECTOR_BLOCKS;
    OutputKernel<<<blocks, nullptr, stream>>>((GM_ADDR)acc, (GM_ADDR)out, (GM_ADDR)scales, h);
}
