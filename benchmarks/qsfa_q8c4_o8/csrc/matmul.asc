// Experimental Ascend 950 direct kernels. These are not the installed QSFA op.
// References (cann/ops-transformer@55498d91634277d4eec912499c027818a8c167fb):
// attention/quant_lightning_indexer_v2/op_kernel/arch35/
//   quant_lightning_indexer_v2_service_cube_arch35.h:
//   QLIV2Matmul::{LoadQScaleToL1,LoadKScaleToL1,LoadQueryToL0a,LoadKeyToL0b,ComputeL0c}
//   -- Dn2Nz E8M0 byte pairs; NT LoadData on both operands; MX L0 types.
// attention/common/op_kernel/FixpipeOut.h::FixpipeMmCopyOutToGm:
//   -- FP32 L0C NZ -> row-major GM.
// The first prototype deliberately uses single buffers and serial pipe fences.
// Its performance must be measured on A5; no speedup is implied by this design.

#include <cstdint>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace QsfaPrototype {
using namespace AscendC;

constexpr uint32_t TILE_M = 16;
constexpr uint32_t TILE_N = 64;
constexpr uint32_t TILE_K = 128;
constexpr uint32_t NOPE_DIM = 512;
constexpr uint32_t ROPE_DIM = 64;
constexpr uint32_t MX_GROUP = 32;
constexpr uint32_t BF16_C0 = 16;
constexpr uint32_t FP8_C0 = 32;
constexpr uint32_t SCALE_PAIRS_PER_ROW = NOPE_DIM / MX_GROUP / 2;
constexpr uint32_t MAX_LAUNCH_BLOCKS = 32;
constexpr FixpipeConfig ROW_MAJOR_GM = {CO2Layout::ROW_MAJOR, false};

// Each event is consumed immediately; no flag is left live across tiles.
// Concrete directions keep producer/consumer order visible to static audits.
__aicore__ inline void FenceMte2Mte1()
{
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
}

__aicore__ inline void FenceMte1M()
{
    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
    WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
}

__aicore__ inline void FenceMte1Mte2()
{
    SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
    WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
}

__aicore__ inline void FenceMMte1()
{
    SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
    WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
}

__aicore__ inline void FenceMFix()
{
    SetFlag<HardEvent::M_FIX>(EVENT_ID0);
    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
}

__aicore__ inline void FenceFixM()
{
    SetFlag<HardEvent::FIX_M>(EVENT_ID0);
    WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
}

// Both arguments of NT GEMM are stored as rows of the reduction dimension.
// ND->NZ uses the same row/K orientation for A and B. The destination memory
// position (A2 versus B2) determines the L0 hardware operand layout.
template <typename T>
__aicore__ inline void CopyRowsToL1(const LocalTensor<T>& dst, const GlobalTensor<T>& src,
                                   uint32_t rows, uint32_t k, uint32_t srcRowStride)
{
    Nd2NzParams copy{};
    copy.ndNum = 1;
    copy.nValue = rows;
    copy.dValue = k;
    copy.srcDValue = srcRowStride;
    copy.dstNzC0Stride = rows;
    copy.dstNzNStride = 1;
    DataCopy(dst, src, copy);
}

__aicore__ inline void CopyMxScaleToL1(const LocalTensor<uint8_t>& dst,
                                      const GlobalTensor<bfloat16_t>& srcPairs, uint32_t rows)
{
    // Each bfloat16_t is only a carrier for two adjacent E8M0 bytes, not a
    // numeric BF16 scale. TILE_K=128 means four byte scales/two pairs per row.
    constexpr uint32_t pairs = TILE_K / MX_GROUP / 2;
    Dn2NzParams copy{};
    copy.dnNum = 1;
    copy.nValue = pairs;
    copy.dValue = rows;
    copy.srcDValue = SCALE_PAIRS_PER_ROW;
    copy.dstNzC0Stride = pairs;
    copy.dstNzNStride = 1;
    DataCopy(dst.ReinterpretCast<bfloat16_t>(), srcPairs, copy);
}

__aicore__ inline LoadData2DParamsV2 MakeNtLoad(uint32_t rows, uint32_t k, uint32_t c0)
{
    LoadData2DParamsV2 load{};
    load.mStep = rows / TILE_M;
    load.kStep = k / c0;
    load.srcStride = rows / TILE_M;
    load.dstStride = rows / TILE_M;
    load.ifTranspose = false;
    return load;
}

__aicore__ inline LoadData2DMxParams MakeMxLoad(uint32_t rows)
{
    LoadData2DMxParams load{};
    load.xStep = rows / TILE_M;
    load.yStep = TILE_K / MX_GROUP / 2;
    load.srcStride = load.yStep;
    load.dstStride = load.yStep;
    return load;
}

class CubeBuffers {
public:
    __aicore__ inline void Init()
    {
        // The same data buffers hold either FP8 NoPE or BF16 RoPE/PV. Size for
        // the larger BF16 payload; MX scale buffers are separate in L1.
        pipe_.InitBuffer(aL1_, TILE_M * TILE_K * sizeof(bfloat16_t));
        pipe_.InitBuffer(bL1_, TILE_N * TILE_K * sizeof(bfloat16_t));
        pipe_.InitBuffer(aScaleL1_, TILE_M * TILE_K / MX_GROUP);
        pipe_.InitBuffer(bScaleL1_, TILE_N * TILE_K / MX_GROUP);
        pipe_.InitBuffer(aL0_, TILE_M * TILE_K * sizeof(bfloat16_t));
        pipe_.InitBuffer(bL0_, TILE_N * TILE_K * sizeof(bfloat16_t));
        pipe_.InitBuffer(cL0_, TILE_M * TILE_N * sizeof(float));
    }

    __aicore__ inline void AccumulateMx(const GlobalTensor<fp8_e4m3fn_t>& a,
                                        const GlobalTensor<fp8_e4m3fn_t>& b,
                                        const GlobalTensor<bfloat16_t>& aScalePairs,
                                        const GlobalTensor<bfloat16_t>& bScalePairs, bool initialize)
    {
        auto aL1 = aL1_.Get<fp8_e4m3fn_t>();
        auto bL1 = bL1_.Get<fp8_e4m3fn_t>();
        auto asL1 = aScaleL1_.Get<uint8_t>();
        auto bsL1 = bScaleL1_.Get<uint8_t>();
        CopyRowsToL1(aL1, a, TILE_M, TILE_K, NOPE_DIM);
        CopyRowsToL1(bL1, b, TILE_N, TILE_K, NOPE_DIM);
        CopyMxScaleToL1(asL1, aScalePairs, TILE_M);
        CopyMxScaleToL1(bsL1, bScalePairs, TILE_N);
        FenceMte2Mte1();

        // mx_fp8_e4m3_t is required for the MX Mmad overload. Using ordinary
        // fp8_e4m3fn_t in L0 would select a different compute contract.
        auto aL0 = aL0_.Get<mx_fp8_e4m3_t>();
        auto bL0 = bL0_.Get<mx_fp8_e4m3_t>();
        LoadData(aL0, aL1, asL1.ReinterpretCast<fp8_e8m0_t>(),
                 MakeNtLoad(TILE_M, TILE_K, FP8_C0), MakeMxLoad(TILE_M));
        LoadData(bL0, bL1, bsL1.ReinterpretCast<fp8_e8m0_t>(),
                 MakeNtLoad(TILE_N, TILE_K, FP8_C0), MakeMxLoad(TILE_N));
        FenceMte1M();
        // Release the single L1 buffer before the next copy, after both loads.
        FenceMte1Mte2();
        Multiply(aL0, bL0, TILE_K, initialize);
    }

    __aicore__ inline void AccumulateBf16(const GlobalTensor<bfloat16_t>& a,
                                          const GlobalTensor<bfloat16_t>& b,
                                          uint32_t k, uint32_t srcRowStride, bool initialize)
    {
        auto aL1 = aL1_.Get<bfloat16_t>();
        auto bL1 = bL1_.Get<bfloat16_t>();
        CopyRowsToL1(aL1, a, TILE_M, k, srcRowStride);
        CopyRowsToL1(bL1, b, TILE_N, k, srcRowStride);
        FenceMte2Mte1();
        auto aL0 = aL0_.Get<bfloat16_t>();
        auto bL0 = bL0_.Get<bfloat16_t>();
        LoadData(aL0, aL1, MakeNtLoad(TILE_M, k, BF16_C0));
        LoadData(bL0, bL1, MakeNtLoad(TILE_N, k, BF16_C0));
        FenceMte1M();
        FenceMte1Mte2();
        Multiply(aL0, bL0, k, initialize);
    }

    __aicore__ inline void Store(const GlobalTensor<float>& dst, uint32_t rowStride)
    {
        FenceMFix();
        FixpipeParamsC310<CO2Layout::ROW_MAJOR> copy{};
        copy.mSize = TILE_M;
        copy.nSize = TILE_N;
        copy.srcStride = TILE_M;
        copy.dstStride = rowStride;
        copy.params.ndNum = 1;
        // Single GM destination: dualDstCtl remains zero (no AIV split).
        Fixpipe<float, float, ROW_MAJOR_GM>(dst, cL0_.Get<float>(), copy);
        FenceFixM();
    }

private:
    template <typename T>
    __aicore__ inline void Multiply(const LocalTensor<T>& a, const LocalTensor<T>& b,
                                    uint32_t k, bool initialize)
    {
        MmadParams mm{};
        mm.m = TILE_M;
        mm.n = TILE_N;
        mm.k = k;
        mm.cmatrixInitVal = initialize;
        mm.cmatrixSource = false;
        Mmad(cL0_.Get<float>(), a, b, mm);
        // This conservative fence also covers small 16x64 Cube tiles.
        PipeBarrier<PIPE_M>();
        FenceMMte1();
    }

    TPipe pipe_;
    TBuf<TPosition::A1> aL1_;
    TBuf<TPosition::B1> bL1_;
    TBuf<TPosition::A1> aScaleL1_;
    TBuf<TPosition::B1> bScaleL1_;
    TBuf<TPosition::A2> aL0_;
    TBuf<TPosition::B2> bL0_;
    TBuf<TPosition::CO1> cL0_;
};

__global__ __aicore__ __cube__ void QkKernel(
    GM_ADDR q, GM_ADDR k, GM_ADDR qs, GM_ADDR ks, GM_ADDR qr, GM_ADDR kr,
    GM_ADDR out, uint32_t m, uint32_t s)
{
    GlobalTensor<fp8_e4m3fn_t> qGm, kGm;
    GlobalTensor<bfloat16_t> qsPairs, ksPairs, qrGm, krGm;
    GlobalTensor<float> outGm;
    qGm.SetGlobalBuffer(reinterpret_cast<__gm__ fp8_e4m3fn_t*>(q));
    kGm.SetGlobalBuffer(reinterpret_cast<__gm__ fp8_e4m3fn_t*>(k));
    qsPairs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(qs));
    ksPairs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ks));
    qrGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(qr));
    krGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(kr));
    outGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out));
    CubeBuffers buffers;
    buffers.Init();
    const uint32_t nTiles = s / TILE_N;
    const uint32_t tiles = (m / TILE_M) * nTiles;
    for (uint32_t tile = GetBlockIdx(); tile < tiles; tile += GetBlockNum()) {
        const uint32_t mOffset = (tile / nTiles) * TILE_M;
        const uint32_t nOffset = (tile % nTiles) * TILE_N;
        for (uint32_t d = 0; d < NOPE_DIM; d += TILE_K) {
            buffers.AccumulateMx(qGm[mOffset * NOPE_DIM + d], kGm[nOffset * NOPE_DIM + d],
                qsPairs[mOffset * SCALE_PAIRS_PER_ROW + d / MX_GROUP / 2],
                ksPairs[nOffset * SCALE_PAIRS_PER_ROW + d / MX_GROUP / 2], d == 0);
        }
        // Preserve the FP32 accumulator across the MX NoPE and BF16 RoPE
        // products. Attention's 1/sqrt(576) factor is applied by softmax later.
        buffers.AccumulateBf16(qrGm[mOffset * ROPE_DIM], krGm[nOffset * ROPE_DIM],
                               ROPE_DIM, ROPE_DIM, false);
        buffers.Store(outGm[mOffset * s + nOffset], s);
    }
}

__global__ __aicore__ __cube__ void PvKernel(
    GM_ADDR p, GM_ADDR vTransposed, GM_ADDR out, uint32_t m, uint32_t s)
{
    GlobalTensor<bfloat16_t> pGm, vGm;
    GlobalTensor<float> outGm;
    pGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p));
    vGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(vTransposed));
    outGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out));
    CubeBuffers buffers;
    buffers.Init();
    constexpr uint32_t nTiles = NOPE_DIM / TILE_N;
    const uint32_t tiles = (m / TILE_M) * nTiles;
    for (uint32_t tile = GetBlockIdx(); tile < tiles; tile += GetBlockNum()) {
        const uint32_t mOffset = (tile / nTiles) * TILE_M;
        const uint32_t nOffset = (tile % nTiles) * TILE_N;
        for (uint32_t token = 0; token < s; token += TILE_K) {
            buffers.AccumulateBf16(pGm[mOffset * s + token], vGm[nOffset * s + token],
                                   TILE_K, s, token == 0);
        }
        buffers.Store(outGm[mOffset * NOPE_DIM + nOffset], NOPE_DIM);
    }
}
} // namespace QsfaPrototype

// Host bridge validates m in {16,32,64}, s in [128,8192] divisible by 128,
// device, dtype, contiguous row-major layout and all allocation sizes before
// entering these raw launchers. They are asynchronous on the provided stream.
extern "C" void qsfa_qk_launch(aclrtStream stream, void* q, void* k, void* qs, void* ks,
                              void* qr, void* kr, void* out, uint32_t m, uint32_t s)
{
    const uint32_t tiles = (m / QsfaPrototype::TILE_M) * (s / QsfaPrototype::TILE_N);
    const uint32_t blocks = tiles < QsfaPrototype::MAX_LAUNCH_BLOCKS ? tiles : QsfaPrototype::MAX_LAUNCH_BLOCKS;
    QsfaPrototype::QkKernel<<<blocks, nullptr, stream>>>(
        static_cast<uint8_t*>(q), static_cast<uint8_t*>(k), static_cast<uint8_t*>(qs),
        static_cast<uint8_t*>(ks), static_cast<uint8_t*>(qr), static_cast<uint8_t*>(kr),
        static_cast<uint8_t*>(out), m, s);
}

extern "C" void qsfa_pv_launch(aclrtStream stream, void* p, void* vTransposed,
                              void* out, uint32_t m, uint32_t s)
{
    const uint32_t tiles = (m / QsfaPrototype::TILE_M) * (QsfaPrototype::NOPE_DIM / QsfaPrototype::TILE_N);
    const uint32_t blocks = tiles < QsfaPrototype::MAX_LAUNCH_BLOCKS ? tiles : QsfaPrototype::MAX_LAUNCH_BLOCKS;
    QsfaPrototype::PvKernel<<<blocks, nullptr, stream>>>(
        static_cast<uint8_t*>(p), static_cast<uint8_t*>(vTransposed), static_cast<uint8_t*>(out), m, s);
}
